{
    "packages": {
        "fmtod/laravel-tabulator": [
            {
                "name": "fmtod/laravel-tabulator",
                "version": "dev-main",
                "version_normalized": "dev-main",
                "source": {
                    "type": "git",
                    "url": "https://github.com/FmTod/laravel-tabulator.git",
                    "reference": "aae711de82e4f58f767bee5f0f2de33ee5dfa477"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/FmTod/laravel-tabulator/zipball/aae711de82e4f58f767bee5f0f2de33ee5dfa477",
                    "reference": "aae711de82e4f58f767bee5f0f2de33ee5dfa477",
                    "shasum": ""
                },
                "require": {
                    "illuminate/contracts": "^10.0",
                    "php": "^8.1|^8.2",
                    "spatie/laravel-package-tools": "^1.9.2"
                },
                "require-dev": {
                    "friendsofphp/php-cs-fixer": "^3.8",
                    "nunomaduro/collision": "^7.0",
                    "nunomaduro/larastan": "^2.0.1",
                    "orchestra/testbench": "^8.0",
                    "pestphp/pest": "^2.0",
                    "pestphp/pest-plugin-laravel": "^2.0",
                    "phpstan/extension-installer": "^1.1",
                    "phpstan/phpstan-deprecation-rules": "^1.0",
                    "phpstan/phpstan-phpunit": "^1.0",
                    "spatie/laravel-ray": "^1.29"
                },
                "time": "2024-10-16T17:05:53+00:00",
                "default-branch": true,
                "type": "library",
                "extra": {
                    "laravel": {
                        "providers": [
                            "FmTod\\LaravelTabulator\\TabulatorServiceProvider"
                        ],
                        "aliases": {
                            "LaravelTabulator": "FmTod\\LaravelTabulator\\Facades\\Tabulator"
                        }
                    }
                },
                "autoload": {
                    "psr-4": {
                        "FmTod\\LaravelTabulator\\": "src"
                    }
                },
                "autoload-dev": {
                    "psr-4": {
                        "FmTod\\LaravelTabulator\\Tests\\": "tests"
                    }
                },
                "scripts": {
                    "analyse": [
                        "vendor/bin/phpstan analyse"
                    ],
                    "test": [
                        "vendor/bin/pest"
                    ],
                    "test-coverage": [
                        "vendor/bin/pest --coverage"
                    ],
                    "format": [
                        "vendor/bin/php-cs-fixer fix --allow-risky=yes"
                    ]
                },
                "license": [
                    "MIT"
                ],
                "authors": [
                    {
                        "name": "Victor Rivero",
                        "email": "victorrivero2415@gmail.com",
                        "role": "Developer"
                    }
                ],
                "description": "This is my package laravel-tabulator",
                "homepage": "https://github.com/fmtod/laravel-tabulator",
                "keywords": [
                    "fmtod",
                    "laravel",
                    "laravel-tabulator"
                ],
                "support": {
                    "source": "https://github.com/FmTod/laravel-tabulator/tree/v1.0.1",
                    "issues": "https://github.com/FmTod/laravel-tabulator/issues"
                }
            }
        ]
    }
}
